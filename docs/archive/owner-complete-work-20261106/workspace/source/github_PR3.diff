+def _sigmoid(x: float) -> float:
+    if x >= 0.0:
+        return 1.0 / (1.0 + math.exp(-x))
+    v = math.exp(x)
+    return v / (1.0 + v)
+
+
+def _clip(x: float, limit: float = 1.0) -> float:
+    return min(limit, max(-limit, x))
